# Local development only — never commit a real .env (it's gitignored).
#
# In the deployed container, these same variable names are populated by the
# platform: Container Apps Jobs secretRefs pointing at Key Vault, resolved
# through a managed identity (see deploy/README.md). Application code only
# ever calls os.getenv — it never talks to Key Vault directly, and the .env
# file itself is never copied into the image (see deploy/Dockerfile).

# Postgres in the cloud; sqlite:///./local.db is fine for local dev.
# For local Postgres via deploy/docker-compose.local.yml:
#   DATABASE_URL=postgresql+psycopg2://pipeline:localdev@localhost:5432/earthquakes
DATABASE_URL=sqlite:///./local.db

# Applied at the USGS API as query params, not filtered in Python, so result
# sets stay small on a first backfill.
MIN_MAGNITUDE=2.5
NOTABLE_MIN_MAGNITUDE=4.5

# "graph" or "none" (none logs the digest instead of sending — safe default).
MAILER=none
DIGEST_TO=you@example.com
DIGEST_FROM=pipeline@example.com

# Only needed when MAILER=graph. App registration needs application-level
# Mail.Send permission, admin-consented, and DIGEST_FROM must be a mailbox
# it's allowed to send as.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
